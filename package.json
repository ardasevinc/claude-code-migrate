{
  "name": "claude-code-migrate",
  "version": "1.12.0",
  "description": "Migrate AI CLI configs (Claude Code, Codex) between machines via SSH or local backup",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "overrides": {
    "vite": "8.1.4"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "MIT",
  "author": "Arda Sevinc <arda@ardasevinc.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardasevinc/claude-code-migrate.git"
  },
  "bugs": {
    "url": "https://github.com/ardasevinc/claude-code-migrate/issues"
  },
  "homepage": "https://github.com/ardasevinc/claude-code-migrate",
  "keywords": [
    "claude-code",
    "codex",
    "migrate",
    "ssh",
    "cli",
    "config",
    "backup",
    "ai"
  ],
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "ccm": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "gate": "bun run lint && bun run format && bun run typecheck && bun run test",
    "full-gate": "bun run gate",
    "check": "bun run gate",
    "check:fix": "biome check --write . && bun run typecheck && bun run test",
    "verify:release": "bun scripts/verify-release.ts",
    "smoke:package": "bun scripts/smoke-package.ts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "smol-toml": "^1.7.0",
    "tar-stream": "3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "1.3.8",
    "@types/tar-stream": "3.1.4",
    "fast-check": "4.9.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
