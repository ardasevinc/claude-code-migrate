{
  "name": "claude-code-migrate",
  "version": "1.4.2",
  "description": "Migrate AI CLI configs (Claude Code, Codex) between machines via SSH or local backup",
  "type": "module",
  "license": "MIT",
  "author": "Arda Sevinc <arda@ardasevinc.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardasevinc/claude-code-migrate.git"
  },
  "homepage": "https://github.com/ardasevinc/claude-code-migrate",
  "keywords": [
    "claude-code",
    "codex",
    "migrate",
    "ssh",
    "cli",
    "config",
    "backup",
    "ai"
  ],
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "ccm": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "gate": "bun run lint && bun run format && bun run typecheck && bun run test",
    "full-gate": "bun run gate",
    "check": "bun run gate",
    "check:fix": "biome check --write . && bun run typecheck && bun run test"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "latest",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
