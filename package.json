{
  "name": "claude-code-migrate",
  "version": "1.0.0",
  "description": "Migrate Claude Code configurations between machines via SSH/SCP or local backup archives",
  "type": "module",
  "bin": {
    "ccm": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "biome lint src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "lint:fix": "biome lint --fix src/",
    "typecheck": "tsc --noEmit",
    "check": "biome check src/ && tsc --noEmit",
    "check:fix": "biome check --fix src/ && tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
