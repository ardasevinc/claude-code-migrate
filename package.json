{
  "name": "claude-code-migrate",
  "version": "1.3.0",
  "description": "Migrate AI CLI configs (Claude Code, Codex) between machines via SSH or local backup",
  "type": "module",
  "license": "MIT",
  "author": "Arda Sevinc <arda@ardasevinc.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardasevinc/claude-code-migrate.git"
  },
  "homepage": "https://github.com/ardasevinc/claude-code-migrate",
  "keywords": [
    "claude-code",
    "codex",
    "migrate",
    "ssh",
    "cli",
    "config",
    "backup",
    "ai"
  ],
  "files": [
    "src/",
    "LICENSE"
  ],
  "bin": {
    "ccm": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "biome lint src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "lint:fix": "biome lint --fix src/",
    "typecheck": "tsc --noEmit",
    "check": "biome check src/ && tsc --noEmit && bun test",
    "check:fix": "biome check --write src/ && tsc --noEmit && bun test"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "smol-toml": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
